# 前端环境变量（Vite 只暴露 VITE_ 前缀变量）
# 后端统一前缀 /api/v1，dev 下由 vite.config.ts 代理到 http://localhost:8000
VITE_API_BASE=/api/v1
# 默认操作人，写入 X-Operator 头用于审计（MVP 单用户）
VITE_DEFAULT_OPERATOR=owner
# 管理员令牌：凭证 / 适配器配置与切换 / 系统设置 / 越权处置 / AI 并发 / 库存配置
# 这些管理端接口后端要求 X-Operator-Token 头，缺失返回 403
#
# ★★ 这里**故意留空**，真实值不入库 ★★
#   一旦把真实令牌写进版本库，它会被 Vite 编进前端产物，
#   最终固化在打包出的 exe 里 —— 任何拿到产物的人都能直接调用管理端接口。
#
#   本机开发：创建 `web/.env.local`（已在 .gitignore 中）写入真实值覆盖：
#       VITE_ADMIN_TOKEN=你的令牌
#   CI 构建：由仓库 Secrets 的同名变量注入，见 .github/workflows/windows-build.yml
VITE_ADMIN_TOKEN=
