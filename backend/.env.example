# ============================================================================
#  自用电商 ERP · 后端环境变量样例
#  用法：复制为 backend/.env 后按需修改。所有值均可通过环境变量覆盖。
# ============================================================================

# ---------------- 应用 ----------------
APP_NAME=selfuse-ecommerce-erp
APP_ENV=dev
DEBUG=true
HOST=127.0.0.1
PORT=8000
API_PREFIX=/api/v1

# ---------------- 数据库 ----------------
# 默认 SQLite 文件库：`<项目根>/data/erp.db`（WAL 模式 + busy_timeout）
#
# ★ ★ ★ 不要写相对路径 ★ ★ ★
#   反例：`sqlite+aiosqlite:///./data/erp.db`
#   相对路径会随**进程工作目录**漂移：以 `backend/` 为 cwd 启动 uvicorn 时连到的是
#   `backend/data/erp.db`（0 表的空库）→ 所有写接口集体 500，而只读接口仍 200。
#   需要自定义时请写**绝对路径**（代码也会把相对路径强制解析到项目根，见 config._resolve_relative_sqlite）。
# DATABASE_URL=sqlite+aiosqlite:///G:/your/project/root/data/erp.db
# 切 PostgreSQL 时改为：postgresql+asyncpg://user:password@localhost:5432/erp
DB_ECHO=false
SQLITE_BUSY_TIMEOUT_MS=8000

# ---------------- 存储（相对项目根目录）----------------
STORAGE_DIR=./data

# ---------------- 安全 ----------------
# ★ 生产环境必须修改
SECRET_KEY=change-me-please
# AES-256 密钥（base64 的 32 字节）；留空则由 SECRET_KEY 派生
CREDENTIAL_KEY=
ADMIN_TOKEN=admin-token
OPERATOR_TOKEN=operator-token

# ---------------- 异步任务 ----------------
TASK_MAX_WORKERS=8
TASK_MAX_RETRY=3
TASK_RECOVERY_ENABLED=true
TASK_RECOVERY_LIMIT=200
SCHEDULER_ENABLED=true
SCHEDULER_TIMEZONE=Asia/Shanghai

# ---------------- 适配器默认（实际生效值读 SystemSetting 表）----------------
# ★ 个体户 / 个人身份证店铺：平台真实 API 多半拿不到资质 → 上架模式默认半自动（manual）
#   见「用户决策 ①」：ManualListingAdapter 是主路径，不是兜底
LISTING_MODE=manual
FULFILLMENT_ACTIVE_ADAPTER=local_csv
# ★ 用户决策 ②：AI = WorkBuddy 文件桥 + HTTP API 双通道，**默认走文件桥**
#   file_bridge：把任务写入 data/ai_queue/<task_id>/prompt.md，等 WorkBuddy 产出
#   http      ：直接调 OpenAI 兼容接口（需配 AI_BASE_URL / AI_API_KEY）
#   mock      ：仅自测用，产出假素材
AI_CLIENT=file_bridge

# ---------------- AI（http / file_bridge 客户端用）----------------
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_IMAGE_MODEL=
AI_TIMEOUT_SEC=60
AI_POLL_INTERVAL_SEC=3
AI_POLL_TIMEOUT_SEC=1800

# ---------------- HTTP ----------------
HTTP_TIMEOUT_SEC=20
HTTP_MAX_RETRY=3
HTTP_RETRY_BACKOFF_SEC=0.5

# ---------------- 日志 ----------------
LOG_LEVEL=INFO
LOG_JSON=false

# ---------------- CORS（逗号分隔）----------------
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
